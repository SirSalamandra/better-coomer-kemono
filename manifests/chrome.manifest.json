{
  "manifest_version": 3,
  "name": "Better Kemono/Coomer",
  "version": "2.0",
  "description": "Tracks URLs accessed within a website and marks them visually.",
  "permissions": ["scripting", "tabs", "storage"],
  "host_permissions": ["https://kemono.cr/*", "https://coomer.cr/*"],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://kemono.cr/*", "https://coomer.cr/*"],
      "js": ["content.js"],
      "css": ["styles.css"]
    }
  ],
  "icons": {
    "16": "icons/logo.svg",
    "48": "icons/logo.svg",
    "128": "icons/logo.svg"
  },
  "action": {
    "default_title": "Abrir Better Su",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/logo.svg",
      "32": "icons/logo.svg"
    }
  }
}
