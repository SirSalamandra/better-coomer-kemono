{
  "manifest_version": 2,
  "name": "Better Kemono/Coomer",
  "version": "2.0.3",
  "description": "Tracks URLs accessed within a website and marks them visually.",
  "permissions": ["tabs", "storage", "https://kemono.cr/*", "https://coomer.st/*"],
  "background": {
    "scripts": ["background.js"],
    "persistent": false
  },
  "content_scripts": [
    {
      "matches": ["https://kemono.cr/*", "https://coomer.st/*"],
      "js": ["content.js"],
      "css": ["styles.css"],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "icons/logo.svg",
    "48": "icons/logo.svg",
    "128": "icons/logo.svg"
  },
  "browser_action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/logo.svg",
      "32": "icons/logo.svg"
    }
  }
}
